          "change": {
            "role": "ADMIN"
          },
          "expected": "422 INVALID_WALLET_REGISTRATION"
        },
        {
          "change": {
            "account_id": "01900000-0000-7000-8000-000000000002"
          },
          "when": "delegated actor remains original ID",
          "expected": "403 WALLET_REGISTRATION_ACTOR_MISMATCH"
        },
        {
          "change": {
            "domain": "individual-owner"
          },
          "when": "caller is another domain service",
          "expected": "403 SOURCE_NOT_AUTHORIZED"
        }
      ]
    },
