{
  "purpose": "SYNTHETIC SAMPLES AND LOCAL CONTRACT STUBS; NOT DEPLOYED DOMAIN CERTIFICATION",
  "core_openapi": "contracts/internal/openapi/payment-service.yaml",
  "public_openapi": "contracts/public/openapi/payments.yaml",
  "event_contracts": "contracts/events/payments/*.schema.json",
  "transport": "Ed25519 service JWT with exact caller, payment-service audience, authenticated delegated domain/account; background registration may omit delegated actor only for its authoritative source service",
  "wallet_provisioning": "POST /internal/v1/wallets/ensure; source registration ref; no opening funds or inferred KYC; durable source outbox/delivery and replay",
  "balance_reads": [
    "GET /internal/v1/wallets/me",
    "GET /internal/v1/wallets/{id}/profile",
    "GET /internal/v1/wallets/{id}/balances",
    "GET /internal/v1/wallets/{id}/transactions"
  ],
  "manual_funding_and_spending": [
    "POST /internal/v1/customer-topups",
    "POST /internal/v1/wallet-spends"
  ],
  "accepted_financial_context": "locked quote + immutable policy version + verified consent/authority + exact entity/currency/business reference; never mutable caller amount or invented fee",
  "deferred_capabilities": [
    "recurring rent execution",
    "saved authorization reuse",
    "customer cash-out",
    "live custody/collections/refunds/transfers"
  ],
  "domains": [
    {
      "domain": "individual-owner",
      "caller": "individual-owner-service",
      "roles": [
        "OWNER",
        "CO_OWNER"
      ],
      "status": "ACTUAL_LOCAL_CONSUMER",
      "test_stub": "TestActualOwnerFinancialCoreConsumer",
      "valid_registration": {
        "account_id": "01900000-0000-7000-8000-000000000001",
        "party_kind": "PERSON",
        "legal_entity": "cosmicforge-ng",
        "currency": "NGN",
        "registration_ref": "SYNTHETIC-CONTRACT-ONLY",
        "domain": "individual-owner",
        "role": "OWNER"
      },
      "invalid_samples": [
