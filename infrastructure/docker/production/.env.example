# Compose-level variables for the PRODUCTION deployment. Copy to .env on the
# host (never commit it). Service secrets live in ${SECRETS_DIR}/<service>.env.

# Digests certified in staging and promoted by promote.yml — never a fresh build.
IMAGE_REGISTRY=ghcr.io/cosmicforgehealthnet/cosmicforge-realestate
API_GATEWAY_DIGEST=sha256:
VERIFICATION_SERVICE_DIGEST=sha256:
MEDIA_DOCUMENT_SERVICE_DIGEST=sha256:
NOTIFICATION_SERVICE_DIGEST=sha256:

SECRETS_DIR=/etc/cosmicforge
GATEWAY_PUBLISH_PORT=8080
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=0.1

# Broker / cache credentials (also embedded in the services' NATS_URL / REDIS_PASSWORD).
NATS_USER=
NATS_PASSWORD=
REDIS_PASSWORD=
