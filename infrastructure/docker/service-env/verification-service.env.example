# ${SECRETS_DIR}/verification-service.env — verification_db credentials only.
DATABASE_URL=postgres://verification_svc:CHANGE_ME@db-host:5432/verification_db?sslmode=require
NATS_URL=nats://NATS_USER:NATS_PASSWORD@nats:4222
SERVICE_AUTH_KEY_ID=
SERVICE_AUTH_PRIVATE_KEY=
# JSON array: [{"service":"api-gateway","keys":[...]},{"service":"media-document-service","keys":[...]}, <domain services>]
SERVICE_AUTH_TRUSTED_KEYS=
# Only the sandbox provider exists today; it is refused in production.
VERIFICATION_PROVIDERS=sandbox-kyc
SANDBOX_KYC_CALLBACK_SECRET=
