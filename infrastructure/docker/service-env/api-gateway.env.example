# ${SECRETS_DIR}/api-gateway.env — provisioned by secrets management (0600). Never commit real values.
# Generate the service key with: go run ./shared/go/cmd/cf-keygen -service api-gateway -kid api-gateway-YYYY-MM
SERVICE_AUTH_KEY_ID=
SERVICE_AUTH_PRIVATE_KEY=
REDIS_PASSWORD=
# JSON array of domain token issuers: [{"issuer":"<domain>-service","domain":"<domain>","keys":[{"kid":"...","public_key":"..."}]}]
GATEWAY_TRUSTED_ISSUERS=
GATEWAY_CORS_ALLOWED_ORIGINS=https://app.example.com
GATEWAY_TRUSTED_PROXIES=
GATEWAY_WEBHOOK_ROUTES=
