# Provision separate API/worker env files from approved secret storage.
# These empty values are not usable credentials. Never commit filled templates.
# APP_ENV and HTTP_ADDR are supplied by the selected deployment manifest.
DATABASE_URL_FILE=/run/secrets/owner/database-url
DB_MAX_CONNS=10
SERVICE_AUTH_KEY_ID=
SERVICE_AUTH_PRIVATE_KEY_FILE=/run/secrets/owner/service-private-key
SERVICE_AUTH_TRUSTED_KEYS_FILE=/run/secrets/owner/trusted-peer-public-keys
SERVICE_AUTH_TOKEN_TTL=2m
OWNER_TOKEN_ISSUER=individual-owner-service
OWNER_TOKEN_AUDIENCE=cosmicforge-realestate-api
OWNER_ACCESS_TOKEN_KEY_ID=
OWNER_ACCESS_TOKEN_PRIVATE_KEY_FILE=/run/secrets/owner/access-private-key
# OWNER_AUTH_PRIVATE_KEY[_FILE] is an alias. Prefer the established name.
# If both aliases exist they must parse to the same key; direct + _FILE is refused.
OWNER_ACCESS_TOKEN_RETIRED_KEYS_FILE=/run/secrets/owner/retired-access-public-keys
OWNER_CODE_PEPPER_FILE=/run/secrets/owner/code-pepper
OWNER_MFA_ENCRYPTION_KEY_ID=
OWNER_MFA_ENCRYPTION_KEY_FILE=/run/secrets/owner/mfa-encryption-key
OWNER_MFA_RETIRED_KEYS_FILE=/run/secrets/owner/retired-mfa-keys
OWNER_PASSWORD_HASH_CONCURRENCY=4
OWNER_ARGON2_MEMORY_KIB=65536
OWNER_ARGON2_ITERATIONS=3
OWNER_ARGON2_PARALLELISM=2
OWNER_PASSWORD_MIN_LENGTH=12
SHUTDOWN_TIMEOUT=20s
NOTIFICATION_SERVICE_URL=http://notification-api:8080
VERIFICATION_SERVICE_URL=http://verification-api:8080
MEDIA_SERVICE_URL=http://media-api:8080
# Enable only alongside the separately certified Payment deployment/trust policy.
PAYMENT_WALLET_SERVICE_URL=
PAYMENT_LEGAL_ENTITY=cosmicforge-ng
PAYMENT_SERVICE_URL=
# Worker only: provision authenticated broker URL privately (do not commit).
NATS_URL=
# Alternatively use NATS_URL_FILE=/run/secrets/owner/broker-url (never both).
NATS_SUBJECT_PREFIX=realestate
NATS_ENSURE_STREAM=true
DOMAIN_WORKER_INTERVAL=30s
PROPERTY_IMPORT_LEASE=2m
OUTBOX_POLL_INTERVAL=500ms
DISPATCH_POLL_INTERVAL=1s
CLOSURE_POLL_INTERVAL=1m
DOWNSTREAM_TIMEOUT=5s
NOTIFICATION_SERVICE_TIMEOUT=5s
# Pin approved business/security policy version; TEST policy is not legal approval.
POLICY_CONFIG_VERSION=
# Absent runtime adapters: selectors/endpoints must stay empty.
CFMEET_PROVIDER=
CFMEET_BASE_URL=
MAPS_PROVIDER=
ESIGN_PROVIDER=
SMART_ACCESS_PROVIDER=
EXTERNAL_LISTING_PROVIDERS=
EXTERNAL_CALENDAR_PROVIDER=
FINANCING_PROVIDER=
INSURANCE_PROVIDER=
MARKETPLACE_SERVICE_URL=
MANAGER_SERVICE_URL=
ARTISAN_SERVICE_URL=
PROFESSIONAL_SERVICE_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACES_SAMPLER_RATIO=0.1
