# ${SECRETS_DIR}/notification-service.env — notification_db credentials only.
DATABASE_URL=postgres://notification_svc:CHANGE_ME@db-host:5432/notification_db?sslmode=require
NATS_URL=nats://NATS_USER:NATS_PASSWORD@nats:4222
SERVICE_AUTH_KEY_ID=
SERVICE_AUTH_PRIVATE_KEY=
SERVICE_AUTH_TRUSTED_KEYS=

# PUSH — Firebase Cloud Messaging is the selected push provider (transport only).
NOTIFY_PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# EMAIL / SMS — no production provider has been selected. Leave disabled
# (requests report CHANNEL_NOT_CONFIGURED) until one is chosen. Optional
# adapters exist (smtp; twilio-compatible) but are never defaults; set their
# variables only if one is deliberately selected (see the service README).
NOTIFY_EMAIL_PROVIDER=disabled
NOTIFY_SMS_PROVIDER=disabled
