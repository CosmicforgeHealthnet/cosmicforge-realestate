# ${SECRETS_DIR}/business-operations-worker.env
# Runtime database role only; no account JWT private signing key or code pepper.
DATABASE_URL=
NATS_URL=nats://nats:4222
NATS_CREDS_FILE=
SERVICE_AUTH_KEY_ID=
SERVICE_AUTH_PRIVATE_KEY_FILE=
SERVICE_AUTH_TRUSTED_KEYS_FILE=
BUSINESS_MFA_KEY_ID=
BUSINESS_MFA_KEY_FILE=
BUSINESS_MFA_RETIRED_KEYS_FILE=
VERIFICATION_SERVICE_URL=http://verification-api:8080
NOTIFICATION_SERVICE_URL=http://notification-api:8080

# Optional signed Media metadata/reference integration; no document bytes are stored.
MEDIA_SERVICE_URL=http://media-document-api:8080

# Optional trusted Marketplace URL. Leave unset until business-supply.v1
# validation, durable command/readback and reciprocal service keys are certified.
MARKETPLACE_SERVICE_URL=
