# ${SECRETS_DIR}/business-operations-service.env — business_operations_db credentials only.
DATABASE_URL=
# API account security (required by the API process; supply through secret files).
# Existing SERVICE_AUTH_KEY_ID/PRIVATE_KEY/TRUSTED_KEYS conventions also apply.
SERVICE_AUTH_KEY_ID=
SERVICE_AUTH_PRIVATE_KEY_FILE=
SERVICE_AUTH_TRUSTED_KEYS_FILE=
BUSINESS_ACCESS_KEY_ID=
BUSINESS_ACCESS_PRIVATE_KEY_FILE=
BUSINESS_ACCESS_RETIRED_KEYS_FILE=
BUSINESS_ACCESS_TTL=15m
BUSINESS_CODE_PEPPER_FILE=
BUSINESS_MFA_KEY_ID=
# File contents: base64-encoded 32-byte AES key; distinct from signing keys/pepper.
BUSINESS_MFA_KEY_FILE=
BUSINESS_MFA_RETIRED_KEYS_FILE=
VERIFICATION_SERVICE_URL=http://verification-api:8080
NOTIFICATION_SERVICE_URL=http://notification-api:8080
# HTTPS frontend page that reads the invitation token from its URL fragment.
BUSINESS_INVITATION_ACCEPT_URL=
