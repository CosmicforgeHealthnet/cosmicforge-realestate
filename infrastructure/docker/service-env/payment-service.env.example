# API and worker share only payment_db credentials. Never commit real values.
DATABASE_URL=
SERVICE_AUTH_KEY_ID=
SERVICE_AUTH_PRIVATE_KEY=
# JSON [{"service":"individual-owner-service","keys":[{"kid":"...","public_key":"..."}]}, ...]
# Include gateway, verification and approved administration keys as needed.
SERVICE_AUTH_TRUSTED_KEYS=
APP_ENV=staging
# API :8080; worker :8081 (set separately when running each process).
HTTP_ADDR=:8080
NATS_URL=
NATS_SUBJECT_PREFIX=realestate
NATS_ENSURE_STREAM=true
# No providers required for wallets. Use a separate entry per entity/merchant/currency.
PAYMENT_PROVIDER_CONFIG=[]
PAYSTACK_BASE_URL=https://api.paystack.co
# Referenced by credentials_ref; blank is not an accepted fallback.
PAYSTACK_NG_TEST_KEY=
PAYMENT_LIVE_CUSTODY_ENABLED=false
PAYMENT_LIVE_TRANSFERS_ENABLED=false
PAYMENT_LIVE_COLLECTIONS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
