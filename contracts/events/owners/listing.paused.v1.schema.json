  "description": "A listing was paused by the owner, a delegate, the system or platform review. Producer: individual-owner-service. Consumers: Marketplace. Aggregate: listing. Generated from the individual-owner-service route registry (cmd/apidocgen); do not edit by hand.",
  "properties": {
    "aggregate_type": {
      "const": "listing"
    },
    "event_type": {
      "const": "listing.paused.v1"
    },
    "payload": {
