        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "property_id": {
          "format": "uuid",
          "type": "string"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "type": "integer"
        },
        "source": {
          "enum": [
            "OWNER",
            "MANAGER",
            "SYSTEM",
            "ADMIN"
          ],
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "version_no": {
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "listing_id",
        "property_id",
        "status",
        "version_no",
        "source",
        "listing_version",
        "occurred_at"
      ],
      "type": "object"
    }
