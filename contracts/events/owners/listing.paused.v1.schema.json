        },
        "available_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "available_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_confirmed_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "next_confirmation_due": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "status",
        "allowed_next_statuses",
        "version"
