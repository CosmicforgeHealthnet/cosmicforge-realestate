{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../schemas/event-envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "finance.reconciliation.exception_detected.v1"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "exception_id": {
          "type": "string",
          "format": "uuid"
        },
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "intent_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
