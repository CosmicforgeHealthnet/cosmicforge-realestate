{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../schemas/event-envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "finance.provider_state_changed.v1"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "$ref": "#/components/schemas/StateChange"
    }
  },
  "components": {
    "schemas": {
      "StateChange": {
        "additionalProperties": false,
        "properties": {
          "aggregate_id": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "prior_state": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "aggregate_id",
          "kind",
          "prior_state",
          "state"
        ],
        "type": "object"
      }
    }
  }
}
