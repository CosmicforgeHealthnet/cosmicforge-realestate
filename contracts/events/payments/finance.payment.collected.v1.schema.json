{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../schemas/event-envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "finance.payment.collected.v1"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "type": "object",
      "properties": {
        "intent_id": {
          "type": "string",
          "format": "uuid"
        },
        "amount_minor": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Validated ISO 4217 currency; integer minor units."
        },
        "settlement_state": {
          "const": "PENDING"
        }
      },
      "required": [
        "intent_id",
        "amount_minor",
        "currency",
        "settlement_state"
      ],
      "additionalProperties": false
    }
  },
  "components": {
    "schemas": {}
  }
}
