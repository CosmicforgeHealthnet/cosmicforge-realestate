{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../schemas/event-envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "finance.wallet_spent.v1"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "$ref": "#/components/schemas/Allocation"
    }
  },
  "components": {
    "schemas": {
      "Allocation": {
        "additionalProperties": false,
        "properties": {
          "allocation_id": {
            "format": "uuid",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "intent_id": {
            "format": "uuid",
            "type": "string"
          },
          "legal_entity": {
            "type": "string"
          },
          "lines": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "amount_minor": {
                  "format": "int64",
                  "type": "integer"
                },
                "authority_id": {
                  "format": "uuid",
                  "type": "string"
                },
                "component_ref": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "line_id": {
                  "format": "uuid",
                  "type": "string"
                },
                "paid_minor": {
                  "format": "int64",
                  "type": "integer"
                },
                "released_minor": {
                  "format": "int64",
                  "type": "integer"
                },
                "reserved_minor": {
                  "format": "int64",
                  "type": "integer"
                },
                "state": {
                  "type": "string"
                },
                "wallet_id": {
                  "format": "uuid",
                  "type": "string"
                }
              },
              "required": [
                "line_id",
                "authority_id",
                "component_ref",
                "kind",
                "amount_minor",
                "currency",
                "state",
                "released_minor",
                "reserved_minor",
                "paid_minor"
              ],
              "type": "object"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "policy_id": {
            "format": "uuid",
            "type": "string"
          },
          "pool_id": {
            "format": "uuid",
            "type": "string"
          },
          "quote_id": {
            "format": "uuid",
            "type": "string"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "allocation_id",
          "intent_id",
          "version",
          "quote_id",
          "policy_id",
          "pool_id",
          "currency",
          "legal_entity",
          "lines"
        ],
        "type": "object"
      }
    }
  }
}
