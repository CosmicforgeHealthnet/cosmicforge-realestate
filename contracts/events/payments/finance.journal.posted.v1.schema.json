{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../schemas/event-envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "finance.journal.posted.v1"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "type": "object",
      "properties": {
        "journal_id": {
          "type": "string",
          "format": "uuid"
        },
        "operation_ref": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Validated ISO 4217 currency; integer minor units."
        },
        "legal_entity": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "journal_id",
        "operation_ref",
        "currency",
        "legal_entity"
      ],
      "additionalProperties": false
    }
  },
  "components": {
    "schemas": {}
  }
}
