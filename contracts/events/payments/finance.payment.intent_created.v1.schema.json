{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../schemas/event-envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "finance.payment.intent_created.v1"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "$ref": "#/components/schemas/Intent"
    }
  },
  "components": {
    "schemas": {
      "Provision": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "party_kind": {
            "type": "string",
            "enum": [
              "PERSON",
              "ORGANIZATION"
            ]
          },
          "legal_entity": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Validated ISO 4217 currency; integer minor units."
          },
          "registration_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "domain",
          "account_id",
          "role",
          "party_kind",
          "legal_entity",
          "currency",
          "registration_ref"
        ],
        "additionalProperties": false
      },
      "Wallet": {
        "type": "object",
        "properties": {
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          },
          "identity_id": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "legal_entity": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Validated ISO 4217 currency; integer minor units."
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RESTRICTED",
              "CLOSED"
            ]
          }
        },
        "required": [
          "wallet_id",
          "identity_id",
          "domain",
          "role",
          "legal_entity",
          "currency",
          "state"
        ],
        "additionalProperties": false
      },
      "Balance": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "PAYMENT_PENDING",
              "PENDING_EARNINGS",
              "PROTECTED",
              "AVAILABLE",
              "FROZEN",
              "WITHDRAWAL_PENDING",
              "REFUND_PENDING"
            ]
          },
          "pool_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount_minor": {
            "type": "string",
            "pattern": "^-?[0-9]+$",
            "description": "Exact aggregate minor units without JSON precision loss."
          },
          "withdrawable": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "pool_id",
          "amount_minor",
          "withdrawable"
        ],
        "additionalProperties": false
      },
      "History": {
        "type": "object",
        "properties": {
          "entry_id": {
            "type": "string",
            "format": "uuid"
          },
          "journal_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_ref": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "enum": [
              "DEBIT",
              "CREDIT"
            ]
          },
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Validated ISO 4217 currency; integer minor units."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "entry_id",
          "journal_id",
          "operation_ref",
          "kind",
          "side",
          "amount_minor",
          "currency",
          "created_at"
        ],
        "additionalProperties": false
      },
      "Link": {
        "type": "object",
        "properties": {
          "identity_id": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "identity_id",
          "domain",
          "account_id",
          "evidence_ref"
        ],
        "additionalProperties": false
      },
      "Verification": {
        "type": "object",
        "properties": {
          "verification_ref": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "REVOKED",
              "EXPIRED"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "verification_ref",
          "state",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "IntentInput": {
        "type": "object",
        "properties": {
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Validated ISO 4217 currency; integer minor units."
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "policy_version": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "requires_custody": {
            "type": "boolean"
          },
          "provider_constraint": {
            "type": "string",
            "format": "uuid"
          },
          "required_liquidity_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Required reconciled provider liquidity for routing; zero for collection-only requests. Configuration is policy input, not custody proof."
          }
        },
        "required": [
          "wallet_id",
          "amount_minor",
          "currency",
          "country",
          "category",
          "evidence_ref",
          "policy_version",
          "email"
        ],
        "additionalProperties": false
      },
      "Intent": {
        "type": "object",
        "properties": {
          "intent_id": {
            "type": "string",
            "format": "uuid"
          },
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Validated ISO 4217 currency; integer minor units."
          },
          "legal_entity": {
            "type": "string",
            "minLength": 1
          },
          "provider_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "pool_id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "REQUESTED",
              "SUBMITTING",
              "INITIALIZED",
              "PENDING",
              "PROCESSING",
              "VERIFIED_SUCCESS",
              "VERIFIED_FAILURE",
              "UNKNOWN_OUTCOME",
              "RECONCILIATION_EXCEPTION"
            ]
          },
          "settlement_state": {
            "type": "string",
            "enum": [
              "PENDING",
              "SETTLED",
              "EXCEPTION"
            ]
          },
          "checkout_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "intent_id",
          "wallet_id",
          "amount_minor",
          "currency",
          "legal_entity",
          "provider_account_id",
          "pool_id",
          "reference",
          "state",
          "settlement_state"
        ],
        "additionalProperties": false
      },
      "Customer": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1
          },
          "first_name": {
            "type": "string",
            "minLength": 1
          },
          "last_name": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "first_name",
          "last_name"
        ],
        "additionalProperties": false
      },
      "Validation": {
        "type": "object",
        "properties": {
          "country": {
            "const": "NG"
          },
          "type": {
            "const": "bank_account"
          },
          "account_number": {
            "type": "string",
            "minLength": 1
          },
          "bvn": {
            "type": "string",
            "minLength": 1
          },
          "bank_code": {
            "type": "string",
            "minLength": 1
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          }
        },
        "required": [
          "country",
          "type",
          "account_number",
          "bvn",
          "bank_code"
        ],
        "additionalProperties": false
      },
      "DVAInput": {
        "type": "object",
        "properties": {
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          },
          "provider_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "consent_ref": {
            "type": "string",
            "minLength": 1
          },
          "consent_version": {
            "type": "string",
            "minLength": 1
          },
          "consent_at": {
            "type": "string",
            "format": "date-time"
          },
          "consent_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "verification_ref": {
            "type": "string",
            "minLength": 1
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "validation": {
            "$ref": "#/components/schemas/Validation"
          }
        },
        "required": [
          "wallet_id",
          "provider_account_id",
          "consent_ref",
          "consent_version",
          "consent_at",
          "consent_expires_at",
          "verification_ref",
          "customer",
          "validation"
        ],
        "additionalProperties": false
      },
      "DVA": {
        "type": "object",
        "properties": {
          "virtual_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "REQUESTED",
              "CUSTOMER_UNKNOWN",
              "VALIDATION_REQUIRED",
              "ASSIGNING",
              "ASSIGNMENT_UNKNOWN",
              "ACTIVE",
              "RESTRICTED",
              "REJECTED",
              "INACTIVE"
            ]
          },
          "account_mask": {
            "type": "string",
            "minLength": 1
          },
          "bank_code": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "virtual_account_id",
          "wallet_id",
          "state"
        ],
        "additionalProperties": false
      },
      "Evidence": {
        "type": "object",
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "evidence_ref"
        ],
        "additionalProperties": false
      },
      "SettlementRequest": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reference"
        ],
        "additionalProperties": false
      },
      "Coverage": {
        "type": "object",
        "properties": {
          "pool_id": {
            "type": "string",
            "format": "uuid"
          },
          "settled_cash_minor": {
            "type": "string"
          },
          "receivable_minor": {
            "type": "string"
          },
          "liability_minor": {
            "type": "string"
          },
          "reserve_minor": {
            "type": "integer",
            "format": "int64"
          },
          "restricted": {
            "type": "boolean"
          },
          "custody_approved": {
            "type": "boolean"
          }
        },
        "required": [
          "pool_id",
          "settled_cash_minor",
          "receivable_minor",
          "liability_minor",
          "reserve_minor",
          "restricted",
          "custody_approved"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "request_id": {
                "type": "string"
              },
              "details": {
                "type": "array"
              },
              "outcome": {
                "type": "string"
              }
            }
          }
        }
      },
      "IdentityControl": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "ACTIVE",
              "RESTRICTED",
              "CLOSED"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "policy_version": {
            "type": "string",
            "minLength": 1
          },
          "approvers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "state",
          "evidence_ref",
          "policy_version"
        ],
        "additionalProperties": false
      },
      "PayoutReferenceInput": {
        "type": "object",
        "properties": {
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          },
          "beneficiary_ref": {
            "type": "string",
            "minLength": 1
          },
          "verification_ref": {
            "type": "string",
            "minLength": 1
          },
          "jurisdiction": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "wallet_id",
          "beneficiary_ref",
          "verification_ref",
          "jurisdiction",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "PayoutReference": {
        "type": "object",
        "properties": {
          "payout_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          },
          "beneficiary_ref": {
            "type": "string",
            "minLength": 1
          },
          "verification_ref": {
            "type": "string",
            "minLength": 1
          },
          "jurisdiction": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "eligible": {
            "const": false
          }
        },
        "required": [
          "payout_account_id",
          "wallet_id",
          "beneficiary_ref",
          "verification_ref",
          "jurisdiction",
          "expires_at",
          "eligible"
        ],
        "additionalProperties": false
      }
    }
  }
}
