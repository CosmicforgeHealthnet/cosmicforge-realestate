{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../schemas/event-envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "finance.payment.intent_created.v1"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "$ref": "#/components/schemas/Intent"
    }
  },
  "components": {
    "schemas": {
      "Intent": {
        "type": "object",
        "properties": {
          "intent_id": {
            "type": "string",
            "format": "uuid"
          },
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Validated ISO 4217 currency; integer minor units."
          },
          "legal_entity": {
            "type": "string",
            "minLength": 1
          },
          "provider_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "pool_id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "REQUESTED",
              "SUBMITTING",
              "INITIALIZED",
              "PENDING",
              "PROCESSING",
              "VERIFIED_SUCCESS",
              "VERIFIED_FAILURE",
              "UNKNOWN_OUTCOME",
              "RECONCILIATION_EXCEPTION"
            ]
          },
          "settlement_state": {
            "type": "string",
            "enum": [
              "PENDING",
              "SETTLED",
              "EXCEPTION"
            ]
          },
          "checkout_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "intent_id",
          "wallet_id",
          "amount_minor",
          "currency",
          "legal_entity",
          "provider_account_id",
          "pool_id",
          "reference",
          "state",
          "settlement_state"
        ],
        "additionalProperties": false
      }
    }
  }
}
