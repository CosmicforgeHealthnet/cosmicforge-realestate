{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../schemas/event-envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "finance.virtual_account.assigned.v1"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "type": "object",
      "properties": {
        "virtual_account_id": {
          "type": "string",
          "format": "uuid"
        },
        "wallet_id": {
          "type": "string",
          "format": "uuid"
        },
        "bank_code": {
          "type": "string",
          "minLength": 1
        },
        "account_mask": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "virtual_account_id",
        "wallet_id",
        "bank_code",
        "account_mask"
      ],
      "additionalProperties": false
    }
  },
  "components": {
    "schemas": {}
  }
}
