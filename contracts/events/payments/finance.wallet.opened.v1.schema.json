{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../schemas/event-envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "finance.wallet.opened.v1"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "$ref": "#/components/schemas/Wallet"
    }
  },
  "components": {
    "schemas": {
      "Wallet": {
        "type": "object",
        "properties": {
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          },
          "identity_id": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "legal_entity": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Validated ISO 4217 currency; integer minor units."
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RESTRICTED",
              "CLOSED"
            ]
          }
        },
        "required": [
          "wallet_id",
          "identity_id",
          "domain",
          "role",
          "legal_entity",
          "currency",
          "state"
        ],
        "additionalProperties": false
      }
    }
  }
}
