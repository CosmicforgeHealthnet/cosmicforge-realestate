{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cosmicforge.realestate/events/business/business.approval.requested.v1.schema.json",
  "title": "business.approval.requested.v1",
  "description": "Producer business-operations-service. Canonical subject realestate.business.approval.requested.v1. State and outbox commit atomically; at-least-once consumers deduplicate event_id. Secret-bearing Notification requests are encrypted, not plaintext.",
  "allOf": [
    {
      "$ref": "../../schemas/event-envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "business.approval.requested.v1"
    },
    "producer": {
      "const": "business-operations-service"
    },
    "payload": {
      "type": "object",
      "properties": {
        "organisation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "target_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "action": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "expired_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "requester_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "state": {
          "enum": [
            "DRAFT",
            "PENDING",
            "APPROVED",
            "REJECTED",
            "EXPIRED",
            "CANCELLED"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "policy_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "organisation_id",
        "approval_id",
        "state",
        "policy_id",
        "policy_version"
      ],
      "additionalProperties": true
    }
  }
}
