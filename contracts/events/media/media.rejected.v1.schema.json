{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cosmicforge.realestate/events/media/media.rejected.v1.schema.json",
  "title": "media.rejected.v1",
  "description": "The file failed inspection and will never become usable. Producer: media-document-service. Subject: realestate.media.rejected.v1. Aggregate: media.",
  "allOf": [{"$ref": "../../schemas/event-envelope.schema.json"}],
  "properties": {
    "event_type": {"const": "media.rejected.v1"},
    "producer": {"const": "media-document-service"},
    "aggregate_type": {"const": "media"},
    "payload": {
      "allOf": [{"$ref": "media-payload.schema.json"}],
      "properties": {"status": {"const": "REJECTED"}},
      "required": ["rejection_reason"]
    }
  }
}
