# Repository-level reference only. Each implemented component documents its
# full configuration in its README (gateway/api-gateway, services/*-service);
# deployment templates live in infrastructure/docker/service-env/. Every
# secret also accepts a *_FILE variant. Never commit real values.
APP_ENV=development
LOG_LEVEL=info

# Tests (go test): integration suites need PostgreSQL; CI sets CF_REQUIRE_INTEGRATION=1
# so missing infrastructure fails instead of skipping.
CF_TEST_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
CF_TEST_REDIS_ADDR=127.0.0.1:6379
CF_TEST_S3_ENDPOINT=
CF_REQUIRE_INTEGRATION=0

# Service identity (every component): Ed25519 key from shared/go/cmd/cf-keygen.
SERVICE_AUTH_KEY_ID=
SERVICE_AUTH_PRIVATE_KEY=
SERVICE_AUTH_TRUSTED_KEYS=


# Remote development dependencies (Docker is not required locally)
POSTGRES_HOST=
POSTGRES_PORT=5432
REDIS_ADDR=
NATS_URL=

# CF Meet
CF_MEET_BASE_URL=
CF_MEET_CLIENT_ID=
CF_MEET_CLIENT_SECRET=
CF_MEET_V2_ENABLED=false

# Firebase is used only for push (FCM) by notification-service; credentials are
# injected through secrets management.
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
# Email/SMS: no production provider selected; development uses capture adapters.
NOTIFY_PUSH_PROVIDER=dev
NOTIFY_EMAIL_PROVIDER=dev
NOTIFY_SMS_PROVIDER=dev

# Object storage (media-document-service)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MEDIA_SCANNER=dev

# Paystack is consumed only by payment-service.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
# Payment foundation: merchant-specific named credential references, no fallback.
PAYMENT_PROVIDER_CONFIG=[]
PAYMENT_LIVE_CUSTODY_ENABLED=false
PAYMENT_LIVE_TRANSFERS_ENABLED=false
PAYMENT_LIVE_COLLECTIONS_ENABLED=false
# Owner's durable automatic wallet bridge; configure when payment-service is deployed.
PAYMENT_WALLET_SERVICE_URL=
PAYMENT_LEGAL_ENTITY=cosmicforge-ng
