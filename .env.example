APP_ENV=development
LOG_LEVEL=info

# Service discovery / internal APIs
INTERNAL_SERVICE_AUTH_ISSUER=
INTERNAL_SERVICE_AUTH_AUDIENCE=

# Remote development dependencies (Docker is not required locally)
POSTGRES_HOST=
POSTGRES_PORT=5432
REDIS_ADDR=
NATS_URL=

# CF Meet
CF_MEET_BASE_URL=
CF_MEET_CLIENT_ID=
CF_MEET_CLIENT_SECRET=
CF_MEET_V2_ENABLED=false

# Firebase server-side credentials are injected through secrets management.
FIREBASE_PROJECT_ID=

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=

# Paystack is consumed only by payment-service.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
