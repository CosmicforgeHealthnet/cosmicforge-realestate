  "item": [
    {
      "name": "00 Platform",
      "description": "Gateway/platform health, readiness and version endpoints. Edge behaviour common to all APIs: errors use the platform envelope (see examples), X-Request-ID is echoed, 401 AUTHENTICATION_REQUIRED / INVALID_TOKEN, 403 PERMISSION_DENIED for a token from another product, 429 RATE_LIMITED with Retry-After, 413 PAYLOAD_TOO_LARGE, 404 ROUTE_NOT_FOUND (including any /internal path).",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness of the API Gateway. No authentication."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Request-ID",
                    "value": "{{request_id}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/health",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "health"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"service\": \"api-gateway\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
