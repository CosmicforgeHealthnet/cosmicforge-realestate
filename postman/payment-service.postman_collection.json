{
  "info": {
    "name": "Payment Service Sections 1-3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /internal/v1/wallets/ensure",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/wallets/ensure",
        "description": "Account authority for the requested domain; registration evidence required. Idempotent by domain/account/role/entity/currency.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"domain\": \"individual-owner\",\n  \"account_id\": \"{{account_id}}\",\n  \"role\": \"OWNER\",\n  \"party_kind\": \"PERSON\",\n  \"legal_entity\": \"cosmicforge-ng\",\n  \"currency\": \"NGN\",\n  \"registration_ref\": \"{{registration_ref}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GET /internal/v1/wallets/{id}",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/wallets/{{entity_id}}",
        "description": "Source-bound delegated wallet owner."
      }
    },
    {
      "name": "GET /internal/v1/wallets/{id}/balances",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/wallets/{{entity_id}}/balances",
        "description": "Source-bound delegated wallet owner; provider pools remain distinct; deposits included in PROTECTED once."
      }
    },
    {
      "name": "GET /internal/v1/wallets/{id}/transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/wallets/{{entity_id}}/transactions",
        "description": "Source-bound delegated wallet owner; use last entry_id as after cursor, limit 1-100."
      }
    },
    {
      "name": "POST /internal/v1/financial-identities/link",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/financial-identities/link",
        "description": "Verification service only; verified cross-domain legal-party evidence. Existing identities are never merged.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identity_id\": \"{{identity_id}}\",\n  \"domain\": \"individual-owner\",\n  \"account_id\": \"{{account_id}}\",\n  \"evidence_ref\": \"{{evidence_ref}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PUT /internal/v1/financial-identities/{id}/verification",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/financial-identities/{{entity_id}}/verification",
        "description": "Verification service only; authoritative status with expiry/revocation; idempotent update.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verification_ref\": \"{{verification_ref}}\",\n  \"state\": \"VERIFIED\",\n  \"expires_at\": \"{{expires_at}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "POST /internal/v1/payment-intents",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/payment-intents",
        "description": "Domain authority with delegated wallet owner, accepted evidence and policy. Durable Idempotency-Key; conflicting fingerprints rejected. Test mode only.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"wallet_id\": \"{{wallet_id}}\",\n  \"amount_minor\": 10000,\n  \"currency\": \"NGN\",\n  \"country\": \"NG\",\n  \"category\": \"RENT\",\n  \"evidence_ref\": \"{{evidence_ref}}\",\n  \"policy_version\": \"v1\",\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GET /internal/v1/payment-intents/{id}",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/payment-intents/{{entity_id}}",
        "description": "Original source service and delegated wallet owner."
      }
    },
    {
      "name": "POST /internal/v1/payment-intents/{id}/verify",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/payment-intents/{{entity_id}}/verify",
        "description": "Original source service and delegated wallet owner. Idempotent economic effect; read-back validates reference/amount/currency/merchant/intent/mode. Does not settle or release funds."
      }
    },
    {
      "name": "POST /internal/v1/virtual-accounts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/virtual-accounts",
        "description": "Domain authority with delegated wallet owner; consent and authoritative KYC, approved test merchant. Idempotent by wallet/provider with fingerprint; repeat unknown customer request performs read-back.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"wallet_id\": \"{{wallet_id}}\",\n  \"provider_account_id\": \"{{provider_account_id}}\",\n  \"consent_ref\": \"{{consent_ref}}\",\n  \"consent_version\": \"{{consent_version}}\",\n  \"consent_at\": \"{{consent_at}}\",\n  \"consent_expires_at\": \"{{consent_expires_at}}\",\n  \"verification_ref\": \"{{verification_ref}}\",\n  \"customer\": {\n    \"email\": \"{{email}}\",\n    \"first_name\": \"{{first_name}}\",\n    \"last_name\": \"{{last_name}}\"\n  },\n  \"validation\": {\n    \"country\": \"NG\",\n    \"type\": \"bank_account\",\n    \"account_number\": \"{{account_number}}\",\n    \"bvn\": \"{{bvn}}\",\n    \"bank_code\": \"{{bank_code}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GET /internal/v1/virtual-accounts/{id}",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/virtual-accounts/{{entity_id}}",
        "description": "Source-bound delegated wallet owner; masked account only."
      }
    },
    {
      "name": "POST /internal/v1/virtual-accounts/{id}/sync",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/virtual-accounts/{{entity_id}}/sync",
        "description": "Domain authority with delegated owner. Provider identification before assignment; requery/fetch for existing account. Unknown assignment uses read-back."
      }
    },
    {
      "name": "POST /internal/v1/virtual-accounts/{id}/deactivate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/virtual-accounts/{{entity_id}}/deactivate",
        "description": "Domain authority with delegated owner; provider deactivation followed by status read-back."
      }
    },
    {
      "name": "POST /internal/v1/provider-inbox/{id}/replay",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/provider-inbox/{{entity_id}}/replay",
        "description": "Admin service only; audit evidence required; active worker lease cannot be overridden; original references retained.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"evidence_ref\": \"{{evidence_ref}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GET /internal/v1/custody-pools/{id}/coverage",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/custody-pools/{{entity_id}}/coverage",
        "description": "Admin service only; raw merchant observations never represented as individual wallet money or licensed custody."
      }
    },
    {
      "name": "POST /internal/v1/provider-accounts/{id}/reconcile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/provider-accounts/{{entity_id}}/reconcile",
        "description": "Admin service only; external merchant balance read-back; mismatches restrict the pool and publish an exception."
      }
    },
    {
      "name": "POST /internal/v1/provider-accounts/{id}/settlements",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/provider-accounts/{{entity_id}}/settlements",
        "description": "Admin service only; immutable external settlement batch observation. Does not credit settled cash or change an intent to SETTLED.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reference\": \"{{reference}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PUT /internal/v1/financial-identities/{id}/state",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/financial-identities/{{entity_id}}/state",
        "description": "Admin service only; evidence and policy required. Restoration requires two distinct recorded approvers. Closure rejects outstanding liabilities/intents and retains history.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"state\": \"ACTIVE\",\n  \"evidence_ref\": \"{{evidence_ref}}\",\n  \"policy_version\": \"v1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "POST /internal/v1/payout-account-references",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/payout-account-references",
        "description": "Verification service only; current authoritative verification, exact beneficiary reference, jurisdiction and expiry. Records bank verification only; no financial entitlement or payout execution. Eligible remains false.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"wallet_id\": \"{{wallet_id}}\",\n  \"beneficiary_ref\": \"{{beneficiary_ref}}\",\n  \"verification_ref\": \"{{verification_ref}}\",\n  \"jurisdiction\": \"NG\",\n  \"expires_at\": \"{{expires_at}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GET /internal/v1/wallets/{id}/payout-account-references",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{payment_base_url}}/internal/v1/wallets/{{entity_id}}/payout-account-references",
        "description": "Source-bound delegated wallet owner; bank reference only, no raw bank details. Recording a reference does not authorize withdrawals."
      }
    },
    {
      "name": "GET /api/v1/payments/wallets/me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "url": "{{gateway_base_url}}/api/v1/payments/wallets/me",
        "description": "Authenticated user through gateway; signed actor domain/account only. No actor supplied through client headers."
      }
    },
    {
      "name": "GET /api/v1/payments/wallets/{id}",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "url": "{{gateway_base_url}}/api/v1/payments/wallets/{{entity_id}}",
        "description": "Source-bound delegated wallet owner."
      }
    },
    {
      "name": "GET /api/v1/payments/wallets/{id}/balances",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "url": "{{gateway_base_url}}/api/v1/payments/wallets/{{entity_id}}/balances",
        "description": "Source-bound delegated wallet owner; provider pools remain distinct; deposits included in PROTECTED once."
      }
    },
    {
      "name": "GET /api/v1/payments/wallets/{id}/transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "url": "{{gateway_base_url}}/api/v1/payments/wallets/{{entity_id}}/transactions",
        "description": "Source-bound delegated wallet owner; use last entry_id as after cursor, limit 1-100."
      }
    },
    {
      "name": "GET /api/v1/payments/payment-intents/{id}",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "url": "{{gateway_base_url}}/api/v1/payments/payment-intents/{{entity_id}}",
        "description": "Original source service and delegated wallet owner."
      }
    },
    {
      "name": "GET /api/v1/payments/virtual-accounts/{id}",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "url": "{{gateway_base_url}}/api/v1/payments/virtual-accounts/{{entity_id}}",
        "description": "Source-bound delegated wallet owner; masked account only."
      }
    },
    {
      "name": "POST Paystack callbacks",
      "request": {
        "method": "POST",
        "url": "{{gateway_base_url}}/webhooks/v1/paystack/{{entity_id}}/callbacks",
        "header": [
          {
            "key": "X-Paystack-Signature",
            "value": "{{raw_body_hmac_sha512}}"
          }
        ],
        "description": "Use exact signed provider body; gateway injects its service JWT. No fake signature fallback."
      }
    }
  ],
  "variable": [
    {
      "key": "payment_base_url",
      "value": "http://localhost:8094"
    },
    {
      "key": "gateway_base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "entity_id",
      "value": ""
    },
    {
      "key": "idempotency_key",
      "value": ""
    }
  ]
}
